{
  "files.associations": { "*.s": "z80-macroasm", "*.inc": "z80-macroasm" },
  "[z80-macroasm]": {
    "editor.defaultFormatter": "jkillian.custom-local-formatters",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 8,
    "editor.detectIndentation": false
  },
  "z80-macroasm.format.enabled": false,
  "z80-macroasm.seekSymbolsThroughWorkspace": true,
  "customLocalFormatters.formatters": [
    {
      "command": "tools/asmfmt/asmfmt",
      "languages": ["z80-macroasm"]
    }
  ]
}
